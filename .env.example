# Copy this file to .env and fill it in. Never commit .env.

# --- Slack ---------------------------------------------------------------------
# OAuth & Permissions > Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-bot-token
# Basic Information > App-Level Tokens (scope: connections:write)
SLACK_APP_TOKEN=xapp-your-app-token
# Channel name (public channels) or channel ID (needed for private channels)
IT_CHANNEL=it-help

# --- Jira ----------------------------------------------------------------------
JIRA_BASE_URL=https://your-site.atlassian.net
# Jira Cloud: the email of the Atlassian account the bot uses (ideally its own, not an admin's; see docs/SETUP.md)
# plus an API token from https://id.atlassian.com/manage-profile/security/api-tokens
# Jira Data Center: leave JIRA_EMAIL empty and put a personal access token in JIRA_API_TOKEN
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-api-token
JIRA_PROJECT_KEY=IT
# Issue type for incidents, and (optionally) a different one for access/change requests
JIRA_ISSUE_TYPE=Task
# JIRA_REQUEST_ISSUE_TYPE=Task
# Label added to every ticket the bot creates (used by the weekly report)
# JIRA_LABEL=slack-it-bot
# Set to false if your project has no Priority field
# JIRA_SET_PRIORITY=true
# Make the requester the Jira reporter, matched by email (needs Jira's Modify Reporter permission; see docs/SETUP.md)
# JIRA_SET_REPORTER=true
# Exact name of the workflow transition that resolves a ticket, if the bot picks the wrong one
# JIRA_DONE_TRANSITION=Resolve this issue
# How often (seconds) to check Jira for status changes to post in the Slack thread (0 turns this off; minimum 10)
# JIRA_SYNC_SECONDS=60

# --- AI (optional) -------------------------------------------------------------
# Without a key the bot still opens tickets, using keyword triage and no AI replies.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-luna
# Only allow links to these domains (and their subdomains) in AI replies; others become "[link removed]"
# AI_ALLOWED_LINK_DOMAINS=microsoft.com, zoom.us
# Describe your lab's tools here so the AI's troubleshooting fits them
# IT_ENVIRONMENT_FILE=docs/it_environment.md

# --- Behaviour -----------------------------------------------------------------
# Who to mention on escalation, in Slack syntax: <@U0123456789> for a person,
# <!subteam^S0123456789> for a user group. Defaults to plain text "The IT team".
# ESCALATION_MENTION=
# IT staff, as comma-separated member IDs (U...) and/or user group IDs (S..., needs the usergroups:read scope).
# Only their replies stop the AI. If empty, a reply from anyone but the requester does.
# IT_STAFF=U0123456789, U0987654321
# AI replies per ticket after the first answer, before it suggests escalating
# MAX_AI_FOLLOW_UPS=3
# Extra posts from the same person within this many seconds join their last ticket (0 turns this off)
# MERGE_WINDOW_SECONDS=120
# Tickets one person can open per hour, against spam and runaway costs (0 turns the limit off)
# MAX_TICKETS_PER_HOUR=10

# --- Weekly report -------------------------------------------------------------
# REPORT_ENABLED=true
# REPORT_DAY=mon
# REPORT_HOUR=9
# REPORT_TIMEZONE=UTC
